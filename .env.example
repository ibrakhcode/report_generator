# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase (after you create the project and run supabase/migrations/20261029_init.sql)
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="YOUR_PUBLISHABLE_KEY"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_ANON_KEY"
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_PUBLISHABLE_KEY="YOUR_PUBLISHABLE_KEY"
SUPABASE_SECRET_KEY="YOUR_SECRET_KEY"
SUPABASE_JWKS_URL="https://YOUR_PROJECT.supabase.co/auth/v1/.well-known/jwks.json"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"

# Outbound report email (Delivery -> Send). Use SMTP or Resend. Attachments are sent as real files.
MAIL_FROM="helpdesk@hesu.co.tz"
MAIL_FROM_NAME="ICT Department"
MAIL_TO=""
SMTP_HOST="mail.hesu.co.tz"
SMTP_PORT="465"
SMTP_USER="helpdesk@hesu.co.tz"
SMTP_PASS=""
RESEND_API_KEY=""
SENDGRID_API_KEY=""

# Microsoft Graph send (Delivery). Azure app: Mail.Send + offline_access. Redirect: {APP_URL}/api/auth/microsoft/callback
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="organizations"

# Password reset OTP still uses Supabase Auth email. Enable Email in Authentication and set the site URL.

# External helpdesk ingest (tickets assigned to Ibrahim Msambwe)
TICKET_INGEST_SECRET="a-long-random-secret"
TICKET_INGEST_ASSIGNEE_EMAIL="imsambwe@hesu.co.tz"
TICKET_INGEST_ASSIGNEE_NAME="Ibrahim Msambwe"
TICEKET_BASE_URL="https://ticeket.netlify.app"
TICEKET_SUPABASE_URL="https://YOUR_TICKET_PROJECT.supabase.co"
TICEKET_SUPABASE_SECRET_KEY="YOUR_TICKET_SECRET_KEY"
TICEKET_USERNAME=""
TICEKET_PASSWORD=""
# Optional extra JSON API if Ticeket login is not used
EXTERNAL_TICKETS_API_URL=""
EXTERNAL_TICKETS_API_KEY=""
